# Copy to .env before running the service outside Docker:
#   cp .env.example .env
#
# Every variable below is required. The service validates them at startup and
# refuses to boot if one is missing or malformed (src/shared/config).
# docker-compose.yml passes the same variables to the containers, so .env is
# only needed for `npm run dev` and the MikroORM CLI on the host.

# development | test | production
NODE_ENV=development

# HTTP port. API is served under /api/v1, probes under /health.
PORT=3000

# Postgres connection string. Host value; inside docker-compose the host is
# "postgres" instead of "localhost".
DATABASE_URL=postgresql://capacity:capacity@localhost:5432/capacity

# Comma-separated Kafka/Redpanda broker list. Host value; inside docker-compose
# the brokers are "redpanda:9092".
KAFKA_BROKERS=localhost:19092

# HS256 signing secret, at least 32 characters. Development value only:
# production uses a managed secret, and RS256/JWKS is the intended end state.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# --- docker compose only (optional) ---------------------------------------
# Host ports published by `docker compose up`. Set these when something else on
# the machine already listens on a default. They do not affect the application:
# inside the compose network the addresses are always postgres:5432,
# redpanda:9092 and api:3000.
# POSTGRES_PORT=5432
# REDPANDA_PORT=19092
# REDPANDA_ADMIN_PORT=9644
# API_PORT=3000
